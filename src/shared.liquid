{% comment %}
  Partials, rendered from the layout files (full, half_horizontal, half_vertical, quadrant) with {% render 'name', arg: value %}.
  Rendered partials see only the arguments passed to them.
{% endcomment %}
{% template due_label %}
{% comment %} Expects due_date, dated_from, utc_offset, today_day. Renders nothing for an unset due date. {% endcomment %}
{% if due_date >= dated_from %}
  {% assign local_due = due_date | date: '%s' | plus: utc_offset %}
  {% assign days_until = local_due | divided_by: 86400 | minus: today_day %}
  <span class="description label task-due">
    {% if days_until < 0 %}Overdue {{ days_until | abs }}d{% elsif days_until == 0 %}Today{% elsif days_until == 1 %}Tomorrow{% else %}{{ local_due | date: '%-d %b' }}{% endif %}
  </span>
{% endif %}
{% endtemplate %}

{% template priority_icon %}
{% comment %} Expects priority (0-5). {% endcomment %}
{% if priority >= 4 %}
  <span class="label label--inverted priority priority--high" aria-label="High priority">!!</span>
{% elsif priority >= 2 %}
  <span class="label priority priority--medium" aria-label="Medium priority">!</span>
{% endif %}
{% endtemplate %}

{% template error_state %}
{% comment %} Expects reason: 'filter' (Vikunja rejected the custom filter) or anything else for a connection or token failure. {% endcomment %}
<div class="item"><div class="content"><span class="title title--small task-error">{% if reason == 'filter' %}Could not load tasks. Check the custom filter syntax.{% else %}Could not load tasks. Check the Vikunja URL and API token.{% endif %}</span></div></div>
{% endtemplate %}

{% template missing_filter_state %}
<div class="item"><div class="content"><span class="title title--small task-error">Custom filter mode is on but no filter is set. Enter a Vikunja filter in the settings.</span></div></div>
{% endtemplate %}

{% template empty_state %}
{% comment %} Expects filtering_projects (true when a Project filter is set) and custom_mode (the user's own filter matched nothing). {% endcomment %}
<div class="item"><div class="content"><span class="title title--small task-empty">{% if custom_mode %}No tasks match the custom filter{% elsif filtering_projects %}No open tasks in the selected Projects{% else %}No open tasks{% endif %}</span></div></div>
{% endtemplate %}

{% template title_icon %}
{% comment %} Vikunja's mark in black and white, inline so it never depends on a network request and stays legible in 1-bit. {% endcomment %}
<img class="image" alt="" src="data:image/svg+xml;base64,">
{% endtemplate %}

{% template overflow_count %}
{% comment %} Sits in the title bar. Empty and hidden until fit_script finds Tasks that do not fit. {% endcomment %}
<span class="instance overflow-count" hidden></span>
{% endtemplate %}

{% template fit_script %}
{% comment %}
  Fits as many Tasks on screen as the space allows. Every Task is rendered into one multi-column flow whose height is the space above
  the title bar; rows that flow past the last column are hidden and counted in the title bar as "+N more".
{% endcomment %}
<style>
  .list.task-flow { display: block; width: 100%; column-gap: 20px; column-fill: auto; overflow: hidden; }
  .task-flow .item { break-inside: avoid; margin-bottom: 8px; }
  .task-flow .group-header { break-after: avoid; }
  .task-flow [hidden], .overflow-count[hidden] { display: none !important; }
</style>
<script>
  (function () {
    function fit() {
      var flow = document.querySelector('.task-flow');
      var bar = document.querySelector('.title_bar');
      var count = document.querySelector('.overflow-count');
      if (!flow) return;
      var items = Array.prototype.slice.call(flow.querySelectorAll('.item'));
      items.forEach(function (item) { item.hidden = false; });
      flow.style.columnCount = flow.getAttribute('data-columns');
      flow.style.height = '';
      var top = flow.getBoundingClientRect().top;
      var bottom = bar ? bar.getBoundingClientRect().top : window.innerHeight;
      flow.style.height = Math.max(0, bottom - top) + 'px';
      var right = flow.getBoundingClientRect().right;
      var hiddenTasks = 0;
      items.forEach(function (item) {
        if (item.getBoundingClientRect().left >= right - 1) {
          item.hidden = true;
          if (item.classList.contains('task')) hiddenTasks += 1;
        }
      });
      items.slice().reverse().forEach(function (item) {
        var next = item.nextElementSibling;
        if (item.classList.contains('group-header') && (!next || next.hidden)) item.hidden = true;
      });
      if (count) {
        count.textContent = hiddenTasks === 0 ? '' : '+' + hiddenTasks + ' more';
        count.hidden = hiddenTasks === 0;
      }
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fit);
    else fit();
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
  })();
</script>
{% endtemplate %}

{% template task_row %}
{% comment %} Expects task, project (may be nil), grouped, dated_from, utc_offset, today_day. {% endcomment %}
<div class="item task">
  {% render 'priority_icon', priority: task.priority %}
  <div class="content">
    <span class="title title--small task-title">{% if project.title and grouped == false %}{{ project.title }} - {% endif %}{{ task.title }}</span>
    {% render 'due_label', due_date: task.due_date, dated_from: dated_from, utc_offset: utc_offset, today_day: today_day %}
  </div>
</div>
{% endtemplate %}

{% template task_rows %}
{% comment %} Expects tasks (already capped), projects, grouped, dated_from, utc_offset, today_day. Grouped rows get a Project header whenever the Project changes. {% endcomment %}
{% assign previous_project_id = nil %}
{% for task in tasks %}
  {% assign project = projects | where: 'id', task.project_id | first %}
  {% if grouped and project.title and task.project_id != previous_project_id %}
    <div class="item group-header"><span class="label label--underline">{{ project.title }}</span></div>
  {% endif %}
  {% assign previous_project_id = task.project_id %}
  {% render 'task_row', task: task, project: project, grouped: grouped, dated_from: dated_from, utc_offset: utc_offset, today_day: today_day %}
{% endfor %}
{% endtemplate %}

{% template task_screen %}
{% comment %}
  Expects tasks_page and projects_page (the v2 collection responses, whose lists sit in `items`), utc_offset, task_source_mode (custom_filter = the user's own filter already selected the Tasks, so project_filter is ignored), custom_filter (the typed filter; blank in custom mode shows a prompt, never unfiltered Tasks), project_filter (comma-separated Project names, empty = all Projects, matched case-insensitively), task_sort_field/task_sort_direction (Task ordering) and project_sort_field/project_sort_direction (Project header ordering in grouped mode), plus columns (1 or 2, default 1: how many columns the Tasks flow through).
  Layout files pass tasks_page: IDX_0, projects_page: IDX_1, utc_offset: trmnl.user.utc_offset and
  group_setting: trmnl.plugin_settings.custom_fields_values.group_by_project, project_filter: trmnl.plugin_settings.custom_fields_values.project_names, task_source_mode: trmnl.plugin_settings.custom_fields_values.task_source_mode, custom_filter: trmnl.plugin_settings.custom_fields_values.custom_filter, task_sort_field: trmnl.plugin_settings.custom_fields_values.task_sort_field, task_sort_direction: trmnl.plugin_settings.custom_fields_values.task_sort_direction, project_sort_field: trmnl.plugin_settings.custom_fields_values.project_sort_field, project_sort_direction: trmnl.plugin_settings.custom_fields_values.project_sort_direction, because partials cannot read trmnl.
  group_setting is the Group by Project setting: grouping is on unless it is false, no, 0 or off (unset = on). Grouping lists Tasks under Project headers.
  Two columns fill the first before the second. Every Task is rendered; fit_script hides the ones that do not fit.
  Tasks carry only project_id, so the Project name is looked up in projects.
{% endcomment %}
{% assign dated_from = "1970" %}
{% assign empty_list = '' | split: ',' %}
{% assign utc_offset = utc_offset | default: 0 %}
{% comment %} A failed or unauthorised request yields no pagination fields; an empty list has page but null items. {% endcomment %}
{% assign load_ok = false %}
{% if tasks_page.page != nil and projects_page.page != nil %}{% assign load_ok = true %}{% endif %}
{% assign tasks = tasks_page.items | default: empty_list %}
{% assign projects = projects_page.items | default: empty_list %}
{% assign filtering_projects = false %}
{% assign filter_projects_ordered = '' | split: ',' %}
{% if load_ok %}
  {% assign wanted_names = project_filter | append: '' | downcase | split: ',' %}
  {% assign wanted_clean = '' | split: ',' %}
  {% for wanted_name in wanted_names %}
    {% assign trimmed_name = wanted_name | strip %}
    {% if trimmed_name != '' %}
      {% assign one_name = trimmed_name | split: '|||' %}
      {% assign wanted_clean = wanted_clean | concat: one_name %}
    {% endif %}
  {% endfor %}
  {% for wanted_name in wanted_clean %}
    {% for candidate in projects %}
      {% assign lower_title = candidate.title | downcase | strip %}
      {% if lower_title == wanted_name %}
        {% assign existing_ids = filter_projects_ordered | map: 'id' %}
        {% unless existing_ids contains candidate.id %}
          {% assign one_project = projects | where: 'id', candidate.id %}
          {% assign filter_projects_ordered = filter_projects_ordered | concat: one_project %}
        {% endunless %}
      {% endif %}
    {% endfor %}
  {% endfor %}
  {% if wanted_clean.size > 0 and task_source_mode != 'custom_filter' %}
    {% assign filtering_projects = true %}
    {% assign wanted_ids = filter_projects_ordered | map: 'id' %}
    {% assign tasks = tasks | where_exp: 't', 'wanted_ids contains t.project_id' %}
  {% endif %}
{% endif %}
{% assign today_day = 'now' | date: '%s' | plus: utc_offset | divided_by: 86400 %}
{% assign columns = columns | default: 1 %}
{% assign grouped = true %}
{% assign group_setting = group_setting | append: '' | downcase %}
{% if group_setting == 'false' or group_setting == 'no' or group_setting == '0' or group_setting == 'off' %}{% assign grouped = false %}{% endif %}
{% assign task_sort_field = task_sort_field | append: '' | downcase | strip %}
{% if task_sort_field == '' %}{% assign task_sort_field = 'due_date' %}{% endif %}
{% assign task_sort_desc = false %}
{% assign task_sort_direction = task_sort_direction | append: '' | downcase | strip %}
{% if task_sort_direction == 'desc' or task_sort_direction == 'descending' %}{% assign task_sort_desc = true %}{% endif %}
{% assign project_sort_field = project_sort_field | append: '' | downcase | strip %}
{% if project_sort_field == '' %}{% assign project_sort_field = 'unsorted' %}{% endif %}
{% assign project_sort_desc = false %}
{% assign project_sort_direction = project_sort_direction | append: '' | downcase | strip %}
{% if project_sort_direction == 'desc' or project_sort_direction == 'descending' %}{% assign project_sort_desc = true %}{% endif %}

{% assign custom_mode = false %}
{% if task_source_mode == 'custom_filter' %}{% assign custom_mode = true %}{% endif %}
{% assign filter_missing = false %}
{% assign filter_text = custom_filter | append: '' | strip %}
{% if custom_mode and filter_text == '' %}{% assign filter_missing = true %}{% endif %}
{% comment %}
  A failed request still hands over its body, never its status. Vikunja's error body carries a numeric code: 4016-4019, 4024 and 4033 are
  its invalid filter errors (4xx), while a bad token (401) has code 11. 5xx and unreachable hosts give an empty body, so no code.
{% endcomment %}
{% assign error_reason = 'connection' %}
{% assign filter_error_codes = '4016,4017,4018,4019,4024,4033' | split: ',' %}
{% assign error_code = tasks_page.code | append: '' %}
{% if custom_mode %}{% if filter_error_codes contains error_code %}{% assign error_reason = 'filter' %}{% endif %}{% endif %}

{% if filter_missing or load_ok == false or tasks.size == 0 %}
  <div class="layout layout--col">
    <div class="list">{% if filter_missing %}{% render 'missing_filter_state' %}{% elsif load_ok %}{% render 'empty_state', filtering_projects: filtering_projects, custom_mode: custom_mode %}{% else %}{% render 'error_state', reason: error_reason %}{% endif %}</div>
  </div>
{% else %}
  {% assign shown = tasks %}
  {% if grouped == false %}
    {% if task_sort_field == 'due_date' %}
      {% assign dated = shown | where_exp: 't', 't.due_date >= dated_from' %}
      {% assign undated = shown | where_exp: 't', 't.due_date == nil or t.due_date < dated_from' %}
      {% assign shown = dated | sort: 'due_date' %}
      {% if task_sort_desc %}{% assign shown = shown | reverse %}{% endif %}
      {% assign shown = shown | concat: undated %}
    {% elsif task_sort_field == 'priority' %}
      {% assign shown = shown | sort: 'priority' %}
      {% if task_sort_desc %}{% assign shown = shown | reverse %}{% endif %}
    {% elsif task_sort_field == 'alphabetical' %}
      {% assign shown = shown | sort: 'title' %}
      {% if task_sort_desc %}{% assign shown = shown | reverse %}{% endif %}
    {% elsif task_sort_field == 'project' %}
      {% assign project_ids = shown | map: 'project_id' | uniq %}
      {% assign ordered_project_ids = '' | split: ',' %}
      {% assign sorted_projects = projects | sort: 'title' %}
      {% if task_sort_desc %}{% assign sorted_projects = sorted_projects | reverse %}{% endif %}
      {% for project in sorted_projects %}
        {% if project_ids contains project.id %}
          {% assign one_id = projects | where: 'id', project.id | map: 'id' %}
          {% assign ordered_project_ids = ordered_project_ids | concat: one_id %}
        {% endif %}
      {% endfor %}
      {% for project_id in project_ids %}
        {% unless ordered_project_ids contains project_id %}
          {% assign one_id = shown | where: 'project_id', project_id | map: 'project_id' | uniq %}
          {% assign ordered_project_ids = ordered_project_ids | concat: one_id %}
        {% endunless %}
      {% endfor %}
      {% assign regrouped = '' | split: ',' %}
      {% for project_id in ordered_project_ids %}
        {% assign project_id_num = project_id | plus: 0 %}
        {% assign in_project = shown | where: 'project_id', project_id_num | sort: 'title' %}
        {% if task_sort_desc %}{% assign in_project = in_project | reverse %}{% endif %}
        {% assign regrouped = regrouped | concat: in_project %}
      {% endfor %}
      {% assign shown = regrouped %}
    {% endif %}
  {% else %}
    {% assign project_ids = shown | map: 'project_id' | uniq %}
    {% if project_sort_field == 'alphabetical' %}
      {% assign ordered_project_ids = '' | split: ',' %}
      {% assign sorted_projects = projects | sort: 'title' %}
      {% if project_sort_desc %}{% assign sorted_projects = sorted_projects | reverse %}{% endif %}
      {% for project in sorted_projects %}
        {% if project_ids contains project.id %}
          {% assign one_id = projects | where: 'id', project.id | map: 'id' %}
          {% assign ordered_project_ids = ordered_project_ids | concat: one_id %}
        {% endif %}
      {% endfor %}
      {% for project_id in project_ids %}
        {% unless ordered_project_ids contains project_id %}
          {% assign one_id = shown | where: 'project_id', project_id | map: 'project_id' | uniq %}
          {% assign ordered_project_ids = ordered_project_ids | concat: one_id %}
        {% endunless %}
      {% endfor %}
      {% assign project_ids = ordered_project_ids %}
    {% elsif project_sort_field == 'project_filter_order' %}
      {% assign ordered_project_ids = '' | split: ',' %}
      {% assign filter_ids = filter_projects_ordered | map: 'id' %}
      {% if project_sort_desc %}{% assign filter_ids = filter_ids | reverse %}{% endif %}
      {% for project_id in filter_ids %}
        {% if project_ids contains project_id %}
          {% assign one_id = shown | where: 'project_id', project_id | map: 'project_id' | uniq %}
          {% assign ordered_project_ids = ordered_project_ids | concat: one_id %}
        {% endif %}
      {% endfor %}
      {% assign fallback_projects = projects | sort: 'title' %}
      {% if project_sort_desc %}{% assign fallback_projects = fallback_projects | reverse %}{% endif %}
      {% for project in fallback_projects %}
        {% if project_ids contains project.id %}
          {% unless ordered_project_ids contains project.id %}
            {% assign one_id = projects | where: 'id', project.id | map: 'id' %}
            {% assign ordered_project_ids = ordered_project_ids | concat: one_id %}
          {% endunless %}
        {% endif %}
      {% endfor %}
      {% for project_id in project_ids %}
        {% unless ordered_project_ids contains project_id %}
          {% assign one_id = shown | where: 'project_id', project_id | map: 'project_id' | uniq %}
          {% assign ordered_project_ids = ordered_project_ids | concat: one_id %}
        {% endunless %}
      {% endfor %}
      {% assign project_ids = ordered_project_ids %}
    {% endif %}
    {% assign regrouped = '' | split: ',' %}
    {% for project_id in project_ids %}
      {% assign project_id_num = project_id | plus: 0 %}
      {% assign in_project = shown | where: 'project_id', project_id_num %}
      {% if task_sort_field == 'due_date' %}
        {% assign dated = in_project | where_exp: 't', 't.due_date >= dated_from' %}
        {% assign undated = in_project | where_exp: 't', 't.due_date == nil or t.due_date < dated_from' %}
        {% assign in_project = dated | sort: 'due_date' %}
        {% if task_sort_desc %}{% assign in_project = in_project | reverse %}{% endif %}
        {% assign in_project = in_project | concat: undated %}
      {% elsif task_sort_field == 'priority' %}
        {% assign in_project = in_project | sort: 'priority' %}
        {% if task_sort_desc %}{% assign in_project = in_project | reverse %}{% endif %}
      {% elsif task_sort_field == 'alphabetical' or task_sort_field == 'project' %}
        {% assign in_project = in_project | sort: 'title' %}
        {% if task_sort_desc %}{% assign in_project = in_project | reverse %}{% endif %}
      {% endif %}
      {% assign regrouped = regrouped | concat: in_project %}
    {% endfor %}
    {% assign shown = regrouped %}
  {% endif %}
  <div class="layout layout--col">
    <div class="list task-flow" data-columns="{{ columns }}">{% render 'task_rows', tasks: shown, projects: projects, grouped: grouped, dated_from: dated_from, utc_offset: utc_offset, today_day: today_day %}</div>
  </div>
{% endif %}

<div class="title_bar">
  {% render 'title_icon' %}
  <span class="title">Vikunja Tasks</span>
  {% if load_ok and tasks.size > 0 and filter_missing == false %}{% render 'overflow_count' %}{% endif %}
</div>
{% if load_ok and tasks.size > 0 and filter_missing == false %}{% render 'fit_script' %}{% endif %}
{% endtemplate %}
